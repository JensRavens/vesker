#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  puts "== Installing dependencies =="
  # ffmpeg (ffprobe) powers video posters, duration, and capture-time extraction.
  # The dev-container base image doesn't ship it, so install it here.
  system!("apt-get update -qq && apt-get install -y --no-install-recommends ffmpeg")

  system("bundle check") || system!("bundle install")

  # Install JavaScript dependencies
  system!("npm install")
  system!("npm install -g @playwright/cli@latest")

  puts "\n== Preparing database =="
  system! "bin/rails db:prepare"
end
