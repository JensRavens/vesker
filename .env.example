# Copy to .env.<environment>.local (gitignored) and fill in. Settings are read via the `Config`
# constant (ENV first, then encrypted credentials). In PRODUCTION the secrets below
# (secret_key_base, smtp_*) live in config/credentials.yml.enc — edit with `bin/rails credentials:edit`,
# unlocked by RAILS_MASTER_KEY (Kamal injects it from config/master.key). This file is for dev/test.

# Public host. Drives mailer links, the WebAuthn relying party (rp_id/origin), and share/OG URLs.
# Required in production (set via Kamal's env.clear; dev/test default to localhost).
HOST=album.example.com

# Outgoing mail — the passwordless login flow emails a one-time code. In production these are the
# flat `smtp_*` keys in encrypted credentials; locally you can override via ENV.
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
# SMTP_USER_NAME=
# SMTP_PASSWORD=
# SMTP_AUTHENTICATION=plain

# Dev/test only: force a fixed login code so you can sign in without a mail server.
# (Set to 999999 in .env.development.)
# LOGIN_CODE=999999

# Optional tuning.
# RAILS_MAX_THREADS=5
# RAILS_LOG_LEVEL=info
# WEB_CONCURRENCY=2
# JOB_CONCURRENCY=1
