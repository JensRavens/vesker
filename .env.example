# Copy to .env.<environment>.local (gitignored) and fill in. Settings are read via the `Config`
# constant (ENV first). Vesker uses NO encrypted Rails credentials — production reads SECRET_KEY_BASE.

# Public host. Drives mailer links, the WebAuthn relying party (rp_id/origin), share/OG URLs, and
# Thruster's TLS certificate domain. Required in production.
HOST=album.example.com

# Signs and encrypts all cookies (sessions, login codes, WebAuthn challenges). Required in
# production — generate with `bin/rails secret`. Dev/test auto-generate a local secret.
# SECRET_KEY_BASE=

# Outgoing mail — the passwordless login flow emails a one-time code.
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
# SMTP_USER_NAME=
# SMTP_PASSWORD=
# SMTP_AUTHENTICATION=plain

# Dev/test only: force a fixed login code so you can sign in without a mail server.
# (Set to 999999 in .env.development.)
# LOGIN_CODE=999999

# Optional tuning.
# RAILS_MAX_THREADS=5
# RAILS_LOG_LEVEL=info
# WEB_CONCURRENCY=2
# JOB_CONCURRENCY=1
